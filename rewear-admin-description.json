      "file": "src/pages/Login.jsx",
      "purpose": "Authentication entry point for administrators",
      "features": [
        "Email and password input fields with validation",
        "Real-time form validation (email format, password minimum 8 characters)",
        "Error display for failed login attempts",
        "Loading state during authentication",
        "Admin privilege verification (user_type must be 'admin')",
        "Auto-redirect to dashboard if already authenticated",
        "Default credentials display for development/testing"
      ],
      "ui_elements": {
        "logo": "Green circular icon with shopping cart symbol",
        "heading": "ReWear Admin",
        "subheading": "Sign in to access the dashboard",
        "background": "Gradient from light green (primary-50) to medium green (primary-100)",
        "form_container": "White rounded card with shadow"
      },
      "validation_rules": {
        "email": ["Required field", "Must be valid email format"],
        "password": ["Required field", "Minimum 8 characters"]
      },
      "authentication_flow": [
        "User enters email and password",
        "Client validates input format",
        "API call to POST /auth/login",
        "Backend verifies credentials and returns user data with tokens",
        "Frontend checks if user_type is 'admin'",
        "If admin: stores access_token and refresh_token in localStorage",
        "Redirects to dashboard (/)",
        "If not admin: shows error 'Access denied. Admin privileges required'"
      ]
    },

