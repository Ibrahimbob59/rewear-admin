  "api_integration": {
    "overview": "Centralized API integration layer with Axios HTTP client, automatic authentication, and token refresh mechanism",
    "configuration": {
      "file": "src/api/axios.js",
      "base_url": "Configured via VITE_API_BASE_URL environment variable",
      "default_timeout": "30000ms (30 seconds)",
      "default_headers": {
        "Content-Type": "application/json",
        "Accept": "application/json"
      }
    },
    "authentication": {
      "method": "JWT (JSON Web Tokens)",
      "token_types": ["access_token", "refresh_token"],
      "storage": "localStorage",
      "header_format": "Authorization: Bearer {access_token}"
    },
    "interceptors": {
      "request_interceptor": {
        "purpose": "Automatically add access token to every request",
        "implementation": "Adds Authorization header before sending request"
      },
      "response_interceptor": {
        "purpose": "Handle token refresh on 401 errors",
        "implementation": [
          "Detects 401 Unauthorized response",
          "Attempts to refresh token using refresh_token",
          "Retries original request with new token",
          "Queues concurrent requests during refresh",
          "Redirects to login if refresh fails"
        ]
      }
    },
    "api_endpoints": {
      "authentication": {
        "login": "POST /auth/login",
        "logout": "POST /auth/logout",
        "get_profile": "GET /auth/me",
        "update_profile": "PUT /auth/profile",
        "change_password": "PUT /auth/password",
        "refresh_token": "POST /auth/refresh-token"
      },
      "admin_operations": {
        "get_statistics": "GET /admin/stats",
        "get_users": "GET /admin/users",
        "create_user": "POST /admin/create-user",
        "delete_user": "DELETE /admin/users/{userId}",
        "get_charities": "GET /admin/charities",
        "create_charity": "POST /admin/charity/create",
        "get_notifications": "GET /admin/notifications",
        "mark_notification_read": "POST /admin/notifications/{id}/read",
        "delete_notification": "DELETE /admin/notifications/{id}",
        "mark_all_read": "POST /admin/notifications/read-all",
        "get_driver_applications": "GET /admin/driver-applications",
        "get_driver_details": "GET /admin/driver-applications/{id}",
        "approve_driver": "POST /admin/driver-applications/{id}/approve",
        "reject_driver": "POST /admin/driver-applications/{id}/reject",
        "set_driver_appointment": "POST /admin/driver-applications/{id}/appointment"
      },
      "items": {
        "get_items": "GET /items",
        "get_item_details": "GET /items/{itemId}",
        "delete_item": "DELETE /items/{itemId}",
        "update_item": "PUT /items/{itemId}"
      },
      "orders": {
        "get_orders": "GET /orders",
        "get_order_details": "GET /orders/{orderId}",
        "update_status": "PUT /orders/{orderId}",
        "cancel_order": "PUT /orders/{orderId}/cancel"
      },
      "deliveries": {
        "get_deliveries": "GET /deliveries",
        "get_delivery_details": "GET /deliveries/{deliveryId}",
        "assign_driver": "POST /deliveries/{deliveryId}/assign-driver",
        "cancel_delivery": "POST /deliveries/{deliveryId}/cancel"
      }
    },
    "error_handling": {
      "network_errors": "Caught and displayed as user-friendly messages",
      "401_errors": "Trigger token refresh flow",
      "403_errors": "Access denied message",
      "404_errors": "Resource not found message",
