{
  "project_metadata": {
    "project_name": "ReWear Admin Dashboard",
    "version": "1.0.0",
    "project_type": "React Single Page Application (SPA)",
    "description": "Complete administrative dashboard for managing the ReWear sustainable fashion platform - a platform for donating, purchasing, and delivering second-hand clothing items with charity partnerships",
    "repository": "rewear-admin",
    "default_admin_credentials": {
      "email": "admin@rewear.com",
      "password": "Admin@12345"
    },
    "development_server": "http://localhost:3000",
    "api_base_url": "http://localhost:8000/api"
  },

  "project_purpose": {
    "overview": "The ReWear Admin Dashboard serves as the central control panel for administrators to manage all aspects of the sustainable fashion platform. It provides comprehensive tools for user management, item oversight, order processing, driver verification, charity coordination, delivery tracking, and platform analytics.",
    "target_users": ["Platform Administrators", "System Operators"],
    "key_business_functions": [
      "Monitor and manage platform users (regular users, charities, drivers)",
      "Oversee donated items listings and inventory",
      "Process and track customer orders",
      "Verify and approve driver applications",
      "Manage charity organization partnerships",
      "Track delivery logistics and driver assignments",
      "Analyze platform performance and generate reports",
      "Handle system notifications and communications"
    ]
  },

  "technology_stack": {
    "frontend_framework": {
      "name": "React",
      "version": "18.3.1",
      "purpose": "Core UI framework for building the user interface",
      "key_features_used": [
        "Functional components with Hooks",
        "Context API for state management",
        "React Router for navigation",
        "JSX for component templating"
      ]
    },
    "build_tool": {
      "name": "Vite",
      "version": "5.1.4",
      "purpose": "Modern build tool and development server",
      "features": ["Hot Module Replacement", "Fast development server", "Optimized production builds"]
    },
    "routing": {
      "name": "React Router DOM",
      "version": "6.22.0",
      "purpose": "Client-side routing and navigation",
      "features": ["Nested routes", "Protected routes", "Programmatic navigation"]
    },
    "styling": {
      "primary_framework": "Tailwind CSS",
      "version": "3.4.1",
      "purpose": "Utility-first CSS framework for rapid UI development",
      "customization": "Custom green color palette (primary-50 to primary-900) representing sustainability",
      "design_approach": "Mobile-first responsive design with utility classes"
    },
    "http_client": {
      "name": "Axios",
      "version": "1.6.7",
      "purpose": "HTTP client for API communication",
      "features": ["Request/response interceptors", "Automatic token refresh", "Error handling"]
    },
    "data_visualization": {
      "name": "Recharts",
      "version": "2.15.4",
      "purpose": "Chart library for analytics and statistics visualization"
    },
    "icons": {
      "name": "Lucide React",
      "version": "0.344.0",
      "purpose": "Consistent icon library for UI elements"
    },
    "language": "JavaScript (ES6+)",
    "package_manager": "npm",
    "development_dependencies": {
      "@vitejs/plugin-react": "4.2.1",
      "autoprefixer": "10.4.23",
      "postcss": "8.5.6"
    }
  },

  "project_structure": {
    "overview": "The project follows a modular React application structure with clear separation of concerns organized by feature and functionality",
    "root_directory": {
      "public/": "Static assets served directly to the browser",
      "src/": "Source code directory",
      ".env": "Environment variables (not in git)",
      ".env.example": "Environment variables template",
      "package.json": "Project dependencies and scripts",
      "tailwind.config.js": "Tailwind CSS configuration",
      "vite.config.js": "Vite build tool configuration",
      "README.md": "Project documentation"
    },
    "src_directory_structure": {
      "api/": "API integration layer - HTTP client configuration and endpoint definitions",
      "assets/": "Static assets (images, logos, etc.)",
      "components/": "Reusable React components organized by feature",
      "context/": "React Context providers for global state management",
      "pages/": "Page-level components for each route",
      "routes/": "Route protection and navigation components",
      "utils/": "Utility functions and helper modules",
      "App.jsx": "Root application component with routing configuration",
      "App.css": "Application-specific styles (minimal usage)",
      "index.css": "Global styles and Tailwind imports",
      "main.jsx": "Application entry point and React initialization"
    },
    "components_directory": {
      "analytics/": "Analytics-specific components (ExportReports)",
      "charities/": "Charity management components (CharityDetailsModal, CreateCharityModal)",
      "common/": "Shared UI components (Button, Input, Table, Modal, Pagination, LoadingSpinner, Toast)",
      "dashboard/": "Dashboard-specific components (StatCard, RecentActivity, QuickActions, UserGrowthChart)",
      "deliveries/": "Delivery management components (DeliveryDetailsModal)",
      "drivers/": "Driver management components (ApproveRejectModal, SetAppointmentModal)",
      "items/": "Item management components (ItemDetailsModal)",
      "layout/": "Layout structure components (Layout, Sidebar, Header)",
      "orders/": "Order management components (OrderDetailsModal)",
      "users/": "User management components (UserDetailsModal, DeleteConfirmModal, AddUserModal)"
    }
  },

